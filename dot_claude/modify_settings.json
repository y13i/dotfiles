#!/bin/sh
# Merge chezmoi-managed keys into the existing ~/.claude/settings.json.
# Keys written ad hoc by Claude Code itself (effortLevel, model, ...) are left untouched so that they don't show up in `chezmoi diff`.
# permissions.allow / permissions.deny are unioned with whatever is already there (sorted & deduped) instead of being overwritten.
set -eu

current=$(cat)
[ -n "$current" ] || current='{}'

managed=$(
  cat <<'JSON'
{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 60,
  "env": {
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1"
  },
  "permissions": {
    "allow": [
      "mcp__claude_ai_Gmail__get_*",
      "mcp__claude_ai_Gmail__list_*",
      "mcp__claude_ai_Gmail__search_*",
      "mcp__claude_ai_Google_Calendar__get_*",
      "mcp__claude_ai_Google_Calendar__list_*",
      "mcp__claude_ai_Google_Calendar__search_*",
      "mcp__claude_ai_Google_Drive__get_*",
      "mcp__claude_ai_Google_Drive__list_*",
      "mcp__claude_ai_Google_Drive__read_*",
      "mcp__claude_ai_Google_Drive__search_*",
      "mcp__claude_ai_Google_Drive__download_*",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:docs.github.com)",
      "WebFetch(domain:github.blog)",
      "WebFetch(domain:obsidian.md)",
      "WebFetch(domain:help.obsidian.md)",
      "WebSearch"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push --force-with-lease:*)"
    ]
  }
}
JSON
)

printf '%s' "$current" | jq --argjson managed "$managed" '
  def union($a; $b): (($a // []) + ($b // [])) | unique;

  . as $current
  | ($current * $managed)
  | .permissions.allow = union($current.permissions.allow; $managed.permissions.allow)
  | .permissions.deny  = union($current.permissions.deny;  $managed.permissions.deny)
'
